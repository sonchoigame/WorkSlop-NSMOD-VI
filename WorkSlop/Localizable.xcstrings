    "Nothing imported. PosterBoard delivers nothing until at least one .tendies is here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing imported. PosterBoard delivers nothing until at least one .tendies is here."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang diimpor. PosterBoard tidak mengirim apa-apa sampai minimal satu .tendies ada di sini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa nhập gì. PosterBoard sẽ không gửi gì cho đến khi có ít nhất một .tendies ở đây."
          }
        }
      }
    },
    "Nothing imported. Templates install and manage delivered PosterBoard content the desktop way.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing imported. Templates install and manage delivered PosterBoard content the desktop way."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang diimpor. Template menginstal dan mengelola konten PosterBoard terkirim ala desktop."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa nhập gì. Các Template cài đặt và quản lý nội dung PosterBoard được gửi theo cách của desktop."
          }
        }
      }
    },
    "Template packages manage delivered PosterBoard content. (The database/Configurations side exists on desktop and is not offered on mobile.)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Template packages manage delivered PosterBoard content. (The database/Configurations side exists on desktop and is not offered on mobile.)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket template mengelola konten PosterBoard terkirim. (Sisi database/Configurations ada di desktop dan tidak ditawarkan di mobile.)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các gói Template quản lý nội dung PosterBoard được gửi. (Phía database/Configurations có trên desktop và không được cung cấp trên mobile.)"
          }
        }
      }
    },
