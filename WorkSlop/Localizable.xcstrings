          "stringUnit": {
            "state": "translated",
            "value": "Versi iOS tidak didukung"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản iOS không được hỗ trợ"
          }
        }
      }
    },
    "This device is running iOS %@. WorkSlop 14.0 supports iOS 16.0 through 27.x.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is running iOS %@. WorkSlop 14.0 supports iOS 16.0 through 27.x."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini menjalankan iOS %@. WorkSlop 14.0 mendukung iOS 16.0 sampai 27.x."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này đang chạy iOS %@. WorkSlop 14.0 hỗ trợ iOS 16.0 đến 27.x."
          }
        }
      }
    },
    "The app will not open on this iOS. Nothing was changed on your device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will not open on this iOS. Nothing was changed on your device."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App tidak akan terbuka di iOS ini. Tidak ada yang diubah di perangkatmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng sẽ không mở trên iOS này. Không có gì bị thay đổi trên thiết bị của bạn."
          }
        }
      }
    },
    "Master": {
