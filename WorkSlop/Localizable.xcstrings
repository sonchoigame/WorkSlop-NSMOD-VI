    "Official iOS 18 icon pack by catwithabaloon (v2.0), shipped byte-identical from WorkSlop Desktop v15.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official iOS 18 icon pack by catwithabaloon (v2.0), shipped byte-identical from WorkSlop Desktop v15."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket ikon iOS 18 resmi oleh catwithabaloon (v2.0), dibawa byte-identical dari WorkSlop Desktop v15."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ biểu tượng iOS 18 chính thức của catwithabaloon (v2.0), được mang nguyên byte-identical từ WorkSlop Desktop v15."
          }
        }
      }
    },
    "Pick an image, fill the app name and its bundle ID (for example com.apple.mobilesafari). Staged icons are written as Home Screen web clips by the same restore payload as the desktop icon themes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an image, fill the app name and its bundle ID (for example com.apple.mobilesafari). Staged icons are written as Home Screen web clips by the same restore payload as the desktop icon themes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gambar, isi nama app dan bundle ID-nya (misal com.apple.mobilesafari). Ikon yang di-stage ditulis sebagai web clip Home Screen lewat payload restore yang sama dengan tema ikon desktop."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một ảnh, điền tên ứng dụng và bundle ID của nó (ví dụ com.apple.mobilesafari). Các biểu tượng đã chọn được ghi dưới dạng web clip màn hình chính bằng cùng payload khôi phục như chủ đề biểu tượng trên desktop."
          }
        }
      }
    },
    "A bundle ID is required before this icon can be staged. The app name may stay empty (hidden label, like desktop).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bundle ID is required before this icon can be staged. The app name may stay empty (hidden label, like desktop)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle ID wajib diisi sebelum ikon ini bisa di-stage. Nama app boleh kosong (label disembunyikan, seperti desktop)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có bundle ID trước khi biểu tượng này được chọn. Tên ứng dụng có thể để trống (nhãn ẩn, như trên desktop)."
          }
        }
      }
    },
