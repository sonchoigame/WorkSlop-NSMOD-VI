    "Partial restore on iOS 26, Full backup → modify → restore on iOS 27 - the same split as desktop.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial restore on iOS 26, Full backup → modify → restore on iOS 27 - the same split as desktop."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial restore di iOS 26, Full backup → modify → restore di iOS 27 - pembagian yang sama dengan desktop."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục một phần trên iOS 26, Sao lưu đầy đủ → modify → khôi phục trên iOS 27 - cách chia giống như desktop."
          }
        }
      }
    },
    "Target: Library/SpringBoard/statusBarOverrides - a fixed 3,944-byte struct, not a plist (firmware-audited on iOS 26.6.1). The full-bars look without a SIM is visual only; it does not restore cellular service.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target: Library/SpringBoard/statusBarOverrides - a fixed 3,944-byte struct, not a plist (firmware-audited on iOS 26.6.1). The full-bars look without a SIM is visual only; it does not restore cellular service."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Target: Library/SpringBoard/statusBarOverrides - struct tetap 3.944 byte, bukan plist (terverifikasi firmware iOS 26.6.1). Tampilan sinyal penuh tanpa SIM hanya visual; tidak mengembalikan layanan seluler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục tiêu: Library/SpringBoard/statusBarOverrides - một struct cố định 3.944 byte, không phải plist (đã kiểm chứng firmware iOS 26.6.1). Hiển thị full sóng khi không có SIM chỉ là hình ảnh; không khôi phục dịch vụ di động."
          }
        }
      }
    },
