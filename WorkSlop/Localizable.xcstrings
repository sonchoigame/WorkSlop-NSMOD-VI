    "iOS 26 and below: Partial restore (sparse restore, no wipe). iOS 27: Full backup → modify → restore with all data - the WorkSlop Desktop method.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 and below: Partial restore (sparse restore, no wipe). iOS 27: Full backup → modify → restore with all data - the WorkSlop Desktop method."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 ke bawah: Partial restore (sparse restore, tanpa wipe). iOS 27: Full backup → modify → restore dengan semua data - metode WorkSlop Desktop."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 trở xuống: Khôi phục một phần (sparse restore, không xóa máy). iOS 27: Sao lưu đầy đủ → modify → khôi phục với toàn bộ dữ liệu - phương pháp của WorkSlop Desktop."
          }
        }
      }
    },
    "Find My must be OFF before an apply and back ON afterwards - same rule as the desktop.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find My must be OFF before an apply and back ON afterwards - same rule as the desktop."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Find My harus MATI sebelum apply dan dinyalakan lagi sesudahnya - aturan yang sama dengan desktop."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Find My phải TẮT trước khi áp dụng và BẬT lại sau đó - cùng quy tắc như trên desktop."
          }
        }
      }
    },
    "A running restore cannot be cancelled mid-flight. If it stalls, turn off the VPN tunnel, then force-restart (Volume Up, Volume Down, hold Side button).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A running restore cannot be cancelled mid-flight. If it stalls, turn off the VPN tunnel, then force-restart (Volume Up, Volume Down, hold Side button)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore yang sedang berjalan tidak bisa dibatalkan di tengah jalan. Jika macet, matikan tunnel VPN, lalu force-restart (Volume Up, Volume Down, tahan tombol Side)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình khôi phục đang chạy không thể hủy giữa chừng. Nếu bị kẹt, hãy tắt đường hầm VPN, rồi khởi động lại cưỡng bức (Tăng âm lượng, Giảm âm lượng, giữ nút Side)."
          }
        }
      }
    },
    "This app cannot reboot your iPhone. After an apply you restart manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app cannot reboot your iPhone. After an apply you restart manually."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App ini tidak bisa me-reboot iPhone. Setelah apply, kamu restart manual."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này không thể khởi động lại iPhone của bạn. Sau khi áp dụng, bạn hãy khởi động lại thủ công."
          }
        }
      }
    },
