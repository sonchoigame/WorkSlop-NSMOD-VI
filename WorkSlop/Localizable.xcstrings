    "Values stage here exactly like the desktop page. The struct is built from the device's captured base during the restore session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values stage here exactly like the desktop page. The struct is built from the device's captured base during the restore session."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai di-stage di sini persis seperti halaman desktop. Struct dibangun dari base yang di-capture perangkat selama sesi restore."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giá trị được chọn ở đây giống hệt trang desktop. Struct được xây dựng từ base đã chụp của thiết bị trong phiên khôi phục."
          }
        }
      }
    },
